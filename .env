# Storage Optimizer configuration (dummy values - fill in your own).
# Real environment variables override anything set here.
# WARNING: once you put a real key in this file, do not commit it.

# "openai" = any OpenAI-compatible API (OpenAI, OpenRouter, Groq, Gemini, Mistral, Ollama, LM Studio)
# "anthropic" = Claude via the official Anthropic SDK (pip install anthropic)
LLM_PROVIDER=anthropic

# Your API key, e.g. LLM_API_KEY=sk-ant-... or sk-...
# Leave empty for local servers like Ollama / LM Studio, or to use ANTHROPIC_API_KEY / OPENAI_API_KEY.
LLM_API_KEY=

# Optional: model name (defaults: claude-opus-5-5 for anthropic, gpt-5 for openai)
LLM_MODEL=

# Optional: API base URL (defaults: https://api.openai.com/v1 for openai, Anthropic's API for anthropic)
# Examples:
#   https://openrouter.ai/api/v1
#   https://generativelanguage.googleapis.com/v1beta/openai
#   http://localhost:11434/v1        (Ollama)
LLM_BASE_URL=
